<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The logo is flat art on a flat cream disc, so it splits properly into
         layers: a colour behind, the mark alone in front. The old sconce
         photo could not be separated that way and had to live entirely in the
         background. -->
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
